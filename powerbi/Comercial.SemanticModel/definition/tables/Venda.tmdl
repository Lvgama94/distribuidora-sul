	partition Venda = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(Servidor, Banco),
				    Dados = Fonte{[Schema = "dw", Item = "fato_venda"]}[Data],
				    Colunas = Table.SelectColumns(Dados, {"data_key", "filial_key", "cliente_key", "produto_key", "vendedor_key", "nf_numero",
				        "tipo_operacao", "valor_bruto", "valor_desconto", "receita_liquida", "custo_total"}),
				    ComNota = Table.AddColumn(Colunas, "nota", each Text.From([filial_key]) & "-" & Text.From([nf_numero]), type text)
				in
				    ComNota

