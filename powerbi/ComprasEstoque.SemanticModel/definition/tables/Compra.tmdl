/// Itens de pedidos de compra. A relação ativa com o calendário é a data do pedido; a entrega real é usada
/// com USERELATIONSHIP. Pontualidade é medida por pedido (todos os itens chegam juntos).
table Compra
	lineageTag: 4cd9c4f0-fe6b-46ec-87eb-e40051c3180c

	column 'Pedido de Compra'
		dataType: int64
		formatString: 0
		lineageTag: 6c6d0d37-4928-474c-aed0-603099216dab
		summarizeBy: none
		sourceColumn: pedido_numero

	column data_pedido_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2de9c303-00d4-4e43-b98f-72df221fc458
		summarizeBy: none
		sourceColumn: data_pedido_key

	column entrega_real_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 69201a6f-5c70-488b-a8a5-6ad07c0ac129
		summarizeBy: none
		sourceColumn: entrega_real_key

	column produto_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ca1dacd1-1cc4-47c9-8dd1-8a9288d72b41
		summarizeBy: none
		sourceColumn: produto_key

	column Quantidade
		dataType: int64
		isHidden
		formatString: #,##0
		lineageTag: b02619dc-9d9e-4a75-b9bf-b25b99352027
		sourceColumn: quantidade

	column 'Valor Total'
		dataType: double
		isHidden
		formatString: R$ #,##0
		lineageTag: 52226b28-0057-4d10-a109-620adc706b45
		sourceColumn: valor_total

	column 'Dias de Atraso na Entrega'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: dd7d2fce-f830-4972-92bd-b35688e3bb07
		summarizeBy: none
		sourceColumn: dias_atraso_entrega

	column 'Entregue no Prazo'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 962e592d-5aef-42ba-829e-7e2c1f3fa40e
		summarizeBy: none
		sourceColumn: entregue_no_prazo

	column Status
		dataType: string
		lineageTag: 46f269a5-a536-48cf-ae39-3425434679b7
		summarizeBy: none
		sourceColumn: status

	partition Compra = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(Servidor, Banco),
				    Dados = Fonte{[Schema = "dw", Item = "fato_compra"]}[Data],
				    Colunas = Table.SelectColumns(Dados, {"pedido_numero", "data_pedido_key", "entrega_real_key", "produto_key",
				        "quantidade", "valor_total", "dias_atraso_entrega", "entregue_no_prazo", "status"}),
				    NoPrazo = Table.TransformColumns(Colunas, {{"entregue_no_prazo", each if _ = null then null else if _ then 1 else 0, Int64.Type}})
				in
				    NoPrazo

