/// Produtos com o fornecedor principal e a classe da curva ABC (receita de 2024 e 2025, todas as filiais,
/// vinda da view dw.vw_curva_abc_produto).
table Produto
	lineageTag: 5db3a3ee-fd0a-416c-8731-7b6b0ef5a1fa

	column produto_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 52cfc62a-057d-4c98-8a20-cdbb28a1188c
		summarizeBy: none
		sourceColumn: produto_key

	column 'Código Produto'
		dataType: string
		lineageTag: 9d73d057-e79d-4d41-9c9f-a7fe8183fd72
		summarizeBy: none
		sourceColumn: cod_produto

	column Produto
		dataType: string
		lineageTag: 42c00b51-73a3-4bde-a921-af88717387c3
		summarizeBy: none
		sourceColumn: descricao

	column Categoria
		dataType: string
		lineageTag: efa697d2-9a61-4177-bfd1-3d409ccf6cf6
		summarizeBy: none
		sourceColumn: categoria

	column Unidade
		dataType: string
		lineageTag: 97be0765-0e78-4006-807c-e2aae53337c8
		summarizeBy: none
		sourceColumn: unidade

	column Fornecedor
		dataType: string
		lineageTag: 61eccc59-3dec-4c65-bf6c-e47ef25a1159
		summarizeBy: none
		sourceColumn: fornecedor

	column 'Preço de Tabela jan/2024'
		dataType: double
		formatString: R$ #,##0.00
		lineageTag: 32701a49-0012-44ca-b0ee-fd95d0dfb690
		summarizeBy: none
		sourceColumn: preco_tabela_jan2024

	column 'Classe ABC'
		dataType: string
		lineageTag: 84ad9d1a-68f7-4696-ab0e-441f089a3807
		summarizeBy: none
		sourceColumn: classe_abc

	column 'Ranking de Receita'
		dataType: int64
		formatString: 0
		lineageTag: bd24fc65-086f-44af-a3ad-50369ebfacb5
		summarizeBy: none
		sourceColumn: ranking

	column 'Participação Acumulada'
		dataType: double
		formatString: 0.0%
		lineageTag: 1351a518-549a-4c18-8b73-1c7465a73e06
		summarizeBy: none
		sourceColumn: participacao_acumulada

	partition Produto = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(Servidor, Banco),
				    Produtos = Fonte{[Schema = "dw", Item = "dim_produto"]}[Data],
				    Abc = Fonte{[Schema = "dw", Item = "vw_curva_abc_produto"]}[Data],
				    AbcColunas = Table.SelectColumns(Abc, {"produto_key", "classe_abc", "ranking", "participacao_acumulada"}),
				    Juntos = Table.NestedJoin(Produtos, {"produto_key"}, AbcColunas, {"produto_key"}, "abc", JoinKind.LeftOuter),
				    Expandido = Table.ExpandTableColumn(Juntos, "abc", {"classe_abc", "ranking", "participacao_acumulada"}),
				    SemChave = Table.RemoveColumns(Expandido, {"fornecedor_key"}),
				    Tipos = Table.TransformColumnTypes(SemChave, {{"ranking", Int64.Type}, {"participacao_acumulada", type number}})
				in
				    Tipos

