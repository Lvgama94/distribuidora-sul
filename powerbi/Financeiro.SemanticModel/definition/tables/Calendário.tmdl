/// Um dia por linha (2023 a 2026), com feriados nacionais e do RS. Marcada como tabela de datas.
table 'Calendário'
	dataCategory: Time

	column data_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: data_key

	column Data
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: data

	column Ano
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: ano

	column Trimestre
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: trimestre

	column 'Mês Nº'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: mes

	column 'Mês'
		dataType: string
		summarizeBy: none
		sourceColumn: nome_mes
		sortByColumn: 'Mês Nº'

	column 'Mês Abreviado'
		dataType: string
		summarizeBy: none
		sourceColumn: mes_abrev
		sortByColumn: 'Mês Nº'

	column 'Ano/Mês Nº'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: ano_mes

	column 'Mês/Ano'
		dataType: string
		summarizeBy: none
		sourceColumn: mes_ano
		sortByColumn: 'Ano/Mês Nº'

	column 'Semana ISO'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: semana_iso

	column 'Dia da Semana Nº'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: dia_semana

	column 'Dia da Semana'
		dataType: string
		summarizeBy: none
		sourceColumn: nome_dia_semana
		sortByColumn: 'Dia da Semana Nº'

	column Feriado
		dataType: boolean
		formatString: """Sim"";""Sim"";""Não"""
		summarizeBy: none
		sourceColumn: feriado

	column 'Dia Útil'
		dataType: boolean
		formatString: """Sim"";""Sim"";""Não"""
		summarizeBy: none
		sourceColumn: dia_util

	column 'Primeiro Dia do Mês'
		dataType: dateTime
		isHidden
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: primeiro_dia_mes

	partition 'Calendário' = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(Servidor, Banco),
				    Dados = Fonte{[Schema = "dw", Item = "dim_calendario"]}[Data]
				in
				    Dados

