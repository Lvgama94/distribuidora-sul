/// Um título por linha: mercadorias (conta 1.05), despesas, folha, encargos, benefícios e impostos.
/// Relação ativa com o calendário pelo vencimento; competência, emissão e pagamento são usados com USERELATIONSHIP.
table 'Contas a Pagar'

	column 'ID Título'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: id_titulo

	column fornecedor_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: fornecedor_key

	column conta_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: conta_key

	column cc_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: cc_key

	column filial_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: filial_key

	column competencia_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: competencia_key

	column emissao_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: emissao_key

	column vencimento_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: vencimento_key

	column pagamento_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: pagamento_key

	column Documento
		dataType: string
		summarizeBy: none
		sourceColumn: documento

	column 'Descrição'
		dataType: string
		summarizeBy: none
		sourceColumn: descricao

	column Valor
		dataType: double
		isHidden
		formatString: R$ #,##0.00
		sourceColumn: valor

	column 'Valor Pago'
		dataType: double
		isHidden
		formatString: R$ #,##0.00
		sourceColumn: valor_pago

	column 'Juros e Multa'
		dataType: double
		isHidden
		formatString: R$ #,##0.00
		sourceColumn: juros_multa

	column Status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	column 'Dias de Atraso'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: dias_atraso

	column 'Prazo Real (dias)'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: prazo_real_dias

	partition 'Contas a Pagar' = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(Servidor, Banco),
				    Dados = Fonte{[Schema = "dw", Item = "fato_conta_pagar"]}[Data]
				in
				    Dados

