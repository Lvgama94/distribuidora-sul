/// DRE realizada por competência: mês x conta x centro de custo x filial.
/// Valor é sempre positivo; Valor Resultado já tem o sinal da conta (receita soma, custos e despesas subtraem).
table DRE
	lineageTag: 4be14f80-86b5-4f95-b083-371e076dd24c

	column competencia_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2476d8c9-7781-459c-a13f-09b5ae5371ff
		summarizeBy: none
		sourceColumn: competencia_key

	column conta_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c813faf8-9e1e-454b-8720-c0acc65303f6
		summarizeBy: none
		sourceColumn: conta_key

	column cc_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 90bc617f-de7b-46a0-b518-3fdb6640ab2f
		summarizeBy: none
		sourceColumn: cc_key

	column filial_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b3e91510-b52e-4250-8667-6f8e2883b812
		summarizeBy: none
		sourceColumn: filial_key

	column Valor
		dataType: double
		isHidden
		formatString: R$ #,##0
