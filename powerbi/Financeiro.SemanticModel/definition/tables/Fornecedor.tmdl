/// Fornecedores de mercadoria, prestadores de serviço e órgãos de governo (impostos e encargos).
table Fornecedor

	column fornecedor_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: fornecedor_key

	column 'Código Fornecedor'
		dataType: string
		summarizeBy: none
		sourceColumn: cod_fornecedor

	column Fornecedor
		dataType: string
		summarizeBy: none
		sourceColumn: razao_social

	column CNPJ
		dataType: string
		summarizeBy: none
		sourceColumn: cnpj

	column 'Tipo de Fornecedor'
		dataType: string
		summarizeBy: none
		sourceColumn: tipo

	column Cidade
		dataType: string
		dataCategory: City
		summarizeBy: none
		sourceColumn: cidade

	column 'Prazo de Pagamento (dias)'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: prazo_pagamento_dias

	column 'Lead Time (dias)'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: lead_time_dias

	partition Fornecedor = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(Servidor, Banco),
				    Dados = Fonte{[Schema = "dw", Item = "dim_fornecedor"]}[Data]
				in
				    Dados

