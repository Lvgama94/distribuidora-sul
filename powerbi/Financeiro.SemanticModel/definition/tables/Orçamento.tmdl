/// Orçamento anual aprovado pela controladoria: mês x conta x centro de custo (sem abertura por filial).
table 'Orçamento'

	column competencia_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: competencia_key

	column conta_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: conta_key

	column cc_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: cc_key

	column Valor
		dataType: double
		isHidden
		formatString: R$ #,##0
		sourceColumn: valor

	partition 'Orçamento' = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(Servidor, Banco),
				    Dados = Fonte{[Schema = "dw", Item = "fato_orcamento"]}[Data]
				in
				    Dados

