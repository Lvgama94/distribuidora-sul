model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Medidas
ref table 'Quadro Mensal'
ref table Ponto
ref table 'Custo de Pessoal'
ref table Funcionário
ref table Calendário
ref table 'Centro de Custo'
ref table Filial

ref cultureInfo pt-BR

