/// Uma linha por funcionário em cada mês em que esteve na empresa. Os indicadores (ativo no início/fim,
/// admitido, desligado, voluntário) vêm como 0 ou 1, para somar headcount e movimentações.
table 'Quadro Mensal'
	lineageTag: a5eeff1e-3872-4d0a-a31c-60e365aa627e

	column competencia_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b36578a5-e7fc-4f64-9d53-f9324326caa7
		summarizeBy: none
		sourceColumn: competencia_key

	column funcionario_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 4ca91aa8-5b3f-44eb-8d1a-5312680d623a
		summarizeBy: none
		sourceColumn: funcionario_key

	column cc_key
