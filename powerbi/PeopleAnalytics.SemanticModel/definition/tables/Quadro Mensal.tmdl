	partition 'Quadro Mensal' = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(Servidor, Banco),
				    Dados = Fonte{[Schema = "dw", Item = "fato_quadro_mensal"]}[Data],
				    Indicadores = {"ativo_inicio_mes", "ativo_fim_mes", "admitido_no_mes", "desligado_no_mes", "desligamento_voluntario"},
				    EmNumeros = Table.TransformColumns(Dados, List.Transform(Indicadores, each {_, (v) => if v then 1 else 0, Int64.Type}))
				in
				    EmNumeros

