		lineageTag: d98030d6-580f-4eb1-8007-3605c5035af5
		summarizeBy: none
		sourceColumn: cc_key

	column filial_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 645c9634-f2df-40f4-ad79-bd3e2e217fee
		summarizeBy: none
