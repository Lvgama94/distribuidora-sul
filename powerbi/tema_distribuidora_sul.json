{
  "name": "Distribuidora Sul",
  "dataColors": ["#1F4E79", "#2E86AB", "#F18F01", "#3B8B5A", "#C73E1D", "#8E7DBE", "#6C757D", "#A23B72"],
  "background": "#FFFFFF",
  "foreground": "#1B2631",
  "tableAccent": "#1F3B57",
  "good": "#2E7D32",
  "neutral": "#B26A00",
  "bad": "#C62828",
  "maximum": "#1F4E79",
  "center": "#E8EEF4",
  "minimum": "#C62828",
  "textClasses": {
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 22, "color": "#1F3B57" },
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#1B2631" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 10, "color": "#1B2631" },
    "label": { "fontFace": "Segoe UI", "fontSize": 9, "color": "#5B6775" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E2E7EE" } }, "radius": 10 }],
        "dropShadow": [{ "show": true, "color": { "solid": { "color": "#1F3B57" } }, "position": "Outer", "preset": "Custom",
                         "transparency": 92, "shadowBlur": 10, "shadowSpread": 0, "shadowDistance": 2, "angle": 90 }],
        "padding": [{ "top": 12, "bottom": 10, "left": 14, "right": 14 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1B2631" } }, "fontSize": 11, "bold": true }],
        "categoryAxis": [{ "showAxisTitle": false, "labelColor": { "solid": { "color": "#5B6775" } }, "fontSize": 9 }],
        "valueAxis": [{ "showAxisTitle": false, "labelColor": { "solid": { "color": "#5B6775" } }, "fontSize": 9,
                        "gridlineColor": { "solid": { "color": "#EDF1F5" } }, "secShowAxisTitle": false }],
        "legend": [{ "show": true, "position": "Top", "labelColor": { "solid": { "color": "#5B6775" } }, "fontSize": 9 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F5F8" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#E9EDF2" } } }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#1F3B57" } }, "fontSize": 22 }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#5B6775" } }, "fontSize": 10 }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "show": true, "fontColor": { "solid": { "color": "#5B6775" } }, "textSize": 8, "bold": true }],
        "items": [{ "fontColor": { "solid": { "color": "#1B2631" } }, "textSize": 10 }],
        "padding": [{ "top": 4, "bottom": 4, "left": 10, "right": 10 }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#1F3B57" } },
                            "fontSize": 10, "bold": true }],
        "rowHeaders": [{ "fontColor": { "solid": { "color": "#1B2631" } }, "fontSize": 10 }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#1B2631" } }, "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
                     "backColorSecondary": { "solid": { "color": "#F6F8FB" } }, "fontSize": 10 }],
        "total": [{ "fontColor": { "solid": { "color": "#1F3B57" } }, "backColor": { "solid": { "color": "#E8EEF4" } }, "bold": true }],
        "grid": [{ "gridVertical": false, "gridHorizontal": false, "rowPadding": 5 }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#1F3B57" } },
                            "fontSize": 10, "bold": true }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#1B2631" } }, "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
                     "backColorSecondary": { "solid": { "color": "#F6F8FB" } }, "fontSize": 10 }],
        "total": [{ "fontColor": { "solid": { "color": "#1F3B57" } }, "backColor": { "solid": { "color": "#E8EEF4" } }, "bold": true }],
        "grid": [{ "gridVertical": false, "gridHorizontal": false, "rowPadding": 5 }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }]
      }
    }
  }
}
